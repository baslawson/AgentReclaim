<Application x:Class="AgentReclaim.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Light-theme defaults; ThemeManager replaces these for dark mode. -->
        <SolidColorBrush x:Key="Accent" Color="#D9772B" />
        <SolidColorBrush x:Key="Muted" Color="#6B6B6B" />
        <SolidColorBrush x:Key="Card" Color="#F6F5F3" />
        <SolidColorBrush x:Key="CardBorder" Color="#E4E1DC" />

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Application.Resources>
</Application>
