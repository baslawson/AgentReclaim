<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon; WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AgentReclaim</AssemblyName>
    <Version>0.6.0</Version>
    <!-- Explorer, taskbar and Alt+Tab icon; regenerate with build/make-icon.ps1. -->
    <ApplicationIcon>Assets/AgentReclaim.ico</ApplicationIcon>
    <!-- Program.Main handles the `hook` and `mcp` command-line modes before any WPF starts. -->
    <StartupObject>AgentReclaim.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets/AgentReclaim.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentReclaim.Core\AgentReclaim.Core.csproj" />
  </ItemGroup>

</Project>
