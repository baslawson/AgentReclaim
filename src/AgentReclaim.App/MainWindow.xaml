<Window x:Class="AgentReclaim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentReclaim.App"
        Title="AgentReclaim" Width="1150" Height="720" MinWidth="760" MinHeight="480"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/AgentReclaim;component/Assets/AgentReclaim.ico">
    <DockPanel Margin="16">
        <!-- Stat tiles -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-10,14">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="System memory" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding SystemMemory}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="System CPU" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding SystemCpu}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="AI coding tools" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding AgentMemory}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding AgentMemoryDetail}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Leftovers you can free" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent}" Text="{Binding Leftovers}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding LeftoversDetail}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource StatLabel}" Text="{Binding Status}" />

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- Tabs left to right in a plain panel: the stock one stretches them and, once they wrap,
                 moves the selected row to the bottom, so the tabs jump around when clicked. -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,2" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <!-- The name matters: screen readers and UI Automation reach the tab content through it. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <!-- Fluent's tab headers have a large fixed width; these size to their text. -->
                <Style TargetType="TabItem">
                    <!-- Not based on Fluent's style, so the theme's text colour has to be set here (the tab content inherits it too). -->
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Chrome" Padding="14,7,14,5" Margin="0,0,2,0" CornerRadius="6,6,0,0" Background="Transparent">
                                    <StackPanel>
                                        <ContentPresenter ContentSource="Header" />
                                        <Border x:Name="Underline" Height="2" Margin="0,5,0,0" CornerRadius="1"
                                                Background="{DynamicResource Accent}" Visibility="Hidden" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Card}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Card}" />
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- Leftovers -->
            <TabItem Header="{Binding OrphansHeader}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Orphans}" Style="{DynamicResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Stop…" Padding="10,2" Margin="2" Click="StopOrphan_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                            <DataGridTextColumn Header="Procs" Binding="{Binding Processes}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" />
                            <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" />
                            <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                            <DataGridTextColumn Header="Was started by" Binding="{Binding Owner}" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Confidence}" />
                            <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="460"
                               Text="Nothing left behind. Processes that Claude Code or Codex started and then abandoned will show up here."
                               Visibility="{Binding HasNoOrphans, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Live sessions: master/detail -->
            <TabItem Header="{Binding SessionsHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                             BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Summary}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Started}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Card}" />
                    <DockPanel Grid.Column="2">
                        <TextBox DockPanel.Dock="Top" IsReadOnly="True" BorderThickness="0" Margin="4,4,4,8"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                 Text="{Binding SelectedSession.CommandLine, Mode=OneWay}" />
                        <DataGrid ItemsSource="{Binding SelectedSession.Members}" Style="{DynamicResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding Name}" FontFamily="Consolas" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="CpuValue" />
                                <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" />
                                <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                                <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Projects: sessions, leftovers and ports grouped by repo / working folder -->
            <TabItem Header="{Binding ProjectsHeader}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Projects}" Style="{DynamicResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding Name}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Sessions" Binding="{Binding Sessions}" />
                            <DataGridTextColumn Header="Procs" Binding="{Binding Processes}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                            <DataGridTextColumn Header="Leftovers" Binding="{Binding Leftovers}" />
                            <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxWidth="460"
                               Text="No Claude Code or Codex sessions or leftovers right now. They are grouped here by the git repo (or folder) they run in."
                               Visibility="{Binding HasNoProjects, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Ports: who is listening, and freeing one -->
            <TabItem Header="{Binding PortsHeader}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,4,8">
                        <TextBlock DockPanel.Dock="Left" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="PortFilter" DockPanel.Dock="Left" Width="160" TextChanged="PortFilter_TextChanged"
                                 ToolTip="A port number, process name, PID or project" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatLabel}" TextWrapping="Wrap"
                                   Text="Every listening TCP port, Claude Code and Codex first. Free… stops the process holding it and its children (a leftover's whole tree), with the same checks and log as Stop… on Leftovers." />
                    </DockPanel>
                    <DataGrid x:Name="PortsGrid" ItemsSource="{Binding Ports}" Style="{DynamicResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Free…" Padding="10,2" Margin="2" Click="FreePort_Click" IsEnabled="{Binding CanFree, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                            <DataGridTextColumn Header="Belongs to" Binding="{Binding Owner}" />
                            <DataGridTextColumn Header="Project" Binding="{Binding Project}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                            <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Findings -->
            <TabItem Header="{Binding FindingsHeader}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatValue}"
                                                       Text="{Binding Memory}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                               Text="No findings right now."
                               Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Cleanup: WSL memory and disk -->
            <TabItem Header="Cleanup" x:Name="CleanupTab">
                <DockPanel Margin="4">
                    <Border DockPanel.Dock="Top" Style="{StaticResource StatCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="WSL and Docker" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding WslSummary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Shut down WSL…" Padding="10,3" Margin="0,0,8,0" Click="WslShutdown_Click" IsEnabled="{Binding IsIdle}" />
                                <Button Content="Turn on automatic reclaim…" Padding="10,3" Margin="0,0,8,0" Click="WslReclaim_Click" IsEnabled="{Binding IsIdle}"
                                        Visibility="{Binding ReclaimOff, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Turn off automatic reclaim…" Padding="10,3" Margin="0,0,8,0" Click="WslReclaimOff_Click" IsEnabled="{Binding IsIdle}"
                                        Visibility="{Binding ReclaimOn, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Refresh" Padding="10,3" Click="WslRefresh_Click" IsEnabled="{Binding IsIdle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource StatCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" Click="DockerRefresh_Click" IsEnabled="{Binding IsIdle}" />
                                <TextBlock FontWeight="SemiBold" Text="Docker containers" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding DockerSummary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <DataGrid ItemsSource="{Binding Containers}" Style="{DynamicResource Grid}" MaxHeight="220"
                                      Visibility="{Binding HasContainers, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Stop…" Padding="10,2" Margin="2" Click="StopContainer_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Container" Binding="{Binding Name}" />
                                    <DataGridTextColumn Header="AI" Binding="{Binding Ai}" />
                                    <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" />
                                    <DataGridTextColumn Header="Up" Binding="{Binding Running}" />
                                    <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" />
                                    <DataGridTextColumn Header="Compose folder" Binding="{Binding Folder}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="Scan disk" Padding="10,3" Margin="0,0,10,0" Click="Scan_Click" IsEnabled="{Binding IsIdle}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{Binding ScanStatus}" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Targets}" Style="{DynamicResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Clean…" Padding="10,2" Margin="2" Click="Clean_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="What" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                            <DataGridTextColumn Header="How" Binding="{Binding Method}" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- History -->
            <TabItem Header="History" x:Name="HistoryTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold" Text="AI-tool memory, last 24 hours" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="0,2,0,6"
                                   Text="All AI coding tools together, and the four projects that used the most. One point a minute while AgentReclaim runs; hover for values." />
                        <WrapPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Rectangle Width="14" Height="3" Fill="{DynamicResource ChartInk}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="All AI tools" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding OnChart}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Rectangle Width="14" Height="3" VerticalAlignment="Center" Margin="0,0,6,0" Tag="{Binding BrushKey}" Loaded="Swatch_Loaded" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <Border Style="{StaticResource StatCard}" Padding="6">
                            <local:HistoryChart x:Name="Chart" Height="240" />
                        </Border>

                        <TextBlock FontWeight="SemiBold" Text="Freed" Margin="0,14,0,2" />
                        <TextBlock Text="{Binding FreedToday}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding FreedAllTime}" TextWrapping="Wrap" />

                        <TextBlock FontWeight="SemiBold" Text="Projects (as a table)" Margin="0,14,0,4" />
                        <DataGrid ItemsSource="{Binding Projects}" Style="{DynamicResource Grid}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="14" Height="3" Margin="6,0" Tag="{Binding BrushKey}" Loaded="Swatch_Loaded" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Project" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Now" Binding="{Binding Now}" />
                                <DataGridTextColumn Header="Peak (24 h)" Binding="{Binding Peak}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Activity -->
            <TabItem Header="Activity">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="4,4,4,8" Style="{StaticResource StatLabel}" TextWrapping="Wrap">
                        Everything AgentReclaim stops is written, with its command line and folder, to actions.jsonl in the data folder (tray menu → Open data folder). Relaunch starts it again in a new window.
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <Button DockPanel.Dock="Right" Content="Relaunch" Padding="8,1" Click="Relaunch_Click"
                                            Visibility="{Binding CanRelaunch, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock DockPanel.Dock="Left" Width="140" Style="{StaticResource StatLabel}" Text="{Binding Time}" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Width" Value="60" />
                                <Setter Property="Margin" Value="6,0" />
                            </Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Margin" Value="0,10,0,2" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Appearance" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding ThemeIndex}" Width="220">
                                <ComboBoxItem Content="Auto (match Windows)" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Automatic actions (all off by default)" Margin="0,20,0,0" />

                        <CheckBox Content="Stop leftovers automatically" IsChecked="{Binding AutoStopLeftovers}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Only leftovers that were seen running under Claude Code or Codex, have no open network connections, pass the safety checks, and have been idle long enough. Guessed owners always wait for you." />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="Idle for at least" VerticalAlignment="Center" />
                            <TextBox Text="{Binding AutoStopIdleMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="minutes (or" VerticalAlignment="Center" />
                            <TextBox Text="{Binding HookGraceSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="seconds after the Claude Code hook reports the session ended)" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Throttle runaway builds and tests" IsChecked="{Binding AutoThrottleBuilds}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Lowers priority and turns on EcoQoS for build/test tools under an agent, so your desktop stays responsive. They still finish." />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="When using over" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ThrottleCpuPercent, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="% CPU for" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ThrottleAfterSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Warn when an agent's memory keeps growing" IsChecked="{Binding LeakWarnings}" />

                        <CheckBox Content="Cap each agent session's memory" IsChecked="{Binding CapSessionMemory}" />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="Processes an agent starts may use at most" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SessionMemoryCapGb, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="GB together" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,4,0,0"
                                   Text="Puts what each agent starts (builds, tests, dev servers, and their children, added within a few seconds of starting) into a Windows job object with this memory limit. The agent itself, other agents and IDEs are never capped. When the limit is reached, the next allocation fails, so a build or server can stop with an out-of-memory error; AgentReclaim tells you when a session hits its cap. Turning this off lifts the caps, except on processes capped before AgentReclaim last restarted (Windows can't take a process out of a job), which keep theirs until they exit." />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Notifications" Margin="0,20,0,0" />
                        <CheckBox Content="Tell me when memory is running low" IsChecked="{Binding LowMemoryAlerts}" />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="When memory use stays above" VerticalAlignment="Center" />
                            <TextBox Text="{Binding LowMemoryAlertPercent, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="%" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,4,0,0"
                                   Text="One notification naming the biggest AI-related users (leftovers, the WSL/Docker VM, sessions, piles of idle children). Click it to open AgentReclaim. It doesn't stop anything, and won't repeat until memory has dropped back down (at most every 30 minutes)." />
                        <CheckBox Content="Tell me when an agent leaves something running" IsChecked="{Binding NotifyNewLeftovers}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="For example &quot;Claude Code left node.exe running on port 5173 (shop)&quot;. Only processes that were seen under an agent, once they've outlived it for a few seconds. It doesn't stop anything." />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Disk cleanup" Margin="0,20,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Only offer folders untouched for" VerticalAlignment="Center" />
                            <TextBox Text="{Binding CleanupMinAgeDays, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="days" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Folders with your git repos (one per line; checked two levels deep for stale worktrees):" Margin="0,8,0,2" />
                        <TextBox Text="{Binding ProjectRoots, UpdateSourceTrigger=LostFocus}" Width="Auto" Margin="0" AcceptsReturn="True" MinHeight="50" />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Integrations" Margin="0,20,0,0" />
                        <TextBlock FontWeight="SemiBold" Text="Claude Code SessionEnd hook" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap"
                                   Text="Adds one hook to ~/.claude/settings.json (with a backup) that tells AgentReclaim when a session ends." />
                        <TextBlock Text="{Binding HookStatus}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install hook…" Padding="10,3" Margin="0,0,8,0" Click="InstallHook_Click" />
                            <Button Content="Remove hook" Padding="10,3" Click="RemoveHook_Click" />
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="MCP server" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap"
                                   Text="Lets an agent ask what is using memory and CPU, and list its own processes. Add it to Claude Code with:" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="10,3" Margin="8,0,0,0" Click="CopyMcp_Click" />
                            <TextBox Text="{Binding McpCommand, Mode=OneWay}" IsReadOnly="True" Width="Auto" Margin="0" FontFamily="Consolas" />
                        </DockPanel>
                        <CheckBox Content="Let agents stop their own processes (off by default)" IsChecked="{Binding AllowAgentSelfStop}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Turns on the stop_my_process tool: the agent that started the MCP server can stop processes in its own tree (e.g. a dev server it left holding a port) and leftovers it was seen starting. Never itself, another agent, anything outside its tree, or protected processes. Every stop is written to the activity log. Your MCP client still asks before each call unless you allowed the tool." />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Startup" Margin="0,20,0,0" />
                        <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Updates" Margin="0,20,0,0" />
                        <TextBlock Text="{Binding VersionText}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="When a new version is released:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding UpdateModeIndex}" Width="300">
                                <ComboBoxItem Content="Don't check" />
                                <ComboBoxItem Content="Tell me, I'll install it (recommended)" />
                                <ComboBoxItem Content="Install it automatically" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Checks github.com/baslawson/AgentReclaim once a day. Downloads are verified against the SHA-256 published with the release before installing. Automatic installs wait until this window is closed, then restart the app in the tray." />
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check now" Padding="10,3" Margin="0,0,8,0" Click="CheckUpdates_Click" />
                            <Button Content="Install update" Padding="10,3" Margin="0,0,8,0" Click="InstallUpdate_Click" IsEnabled="{Binding UpdateAvailable}" />
                            <Button Content="Release notes" Padding="10,3" Click="ReleaseNotes_Click" />
                        </StackPanel>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Diagnostics" Margin="0,20,0,0" />
                        <CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Logs every poll and decision, not just actions and errors. Logs stay on this PC (7 days, 10 MB a day). Debug logs include command lines, which can contain secrets passed as arguments: check before sharing one." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open logs folder" Padding="10,3" Margin="0,0,8,0" Click="OpenLogs_Click" />
                            <Button Content="Copy diagnostics" Padding="10,3" Click="CopyDiagnostics_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
