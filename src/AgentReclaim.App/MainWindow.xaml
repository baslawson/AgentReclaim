<Window x:Class="AgentReclaim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentReclaim" Width="1150" Height="720" MinWidth="760" MinHeight="480"
        Background="White" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <!-- Stat tiles -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-10,14">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="System memory" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding SystemMemory}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="System CPU" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding SystemCpu}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="AI coding tools" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding AgentMemory}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding AgentMemoryDetail}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Leftovers you can free" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{StaticResource Accent}" Text="{Binding Leftovers}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding LeftoversDetail}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource StatLabel}" Text="{Binding Status}" />

        <TabControl>
            <!-- Leftovers -->
            <TabItem Header="{Binding OrphansHeader}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Orphans}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Stop…" Padding="10,2" Margin="2" Click="StopOrphan_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                            <DataGridTextColumn Header="Procs" Binding="{Binding Processes}" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" />
                            <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" />
                            <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                            <DataGridTextColumn Header="Was started by" Binding="{Binding Owner}" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Confidence}" />
                            <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="460"
                               Text="Nothing left behind. Processes that Claude Code or Codex started and then abandoned will show up here."
                               Visibility="{Binding HasNoOrphans, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Live sessions: master/detail -->
            <TabItem Header="{Binding SessionsHeader}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                             BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Summary}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Started}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Card}" />
                    <DockPanel Grid.Column="2">
                        <TextBox DockPanel.Dock="Top" IsReadOnly="True" BorderThickness="0" Margin="4,4,4,8"
                                 TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                 Text="{Binding SelectedSession.CommandLine, Mode=OneWay}" />
                        <DataGrid ItemsSource="{Binding SelectedSession.Members}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding Name}" FontFamily="Consolas" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="CpuValue" />
                                <DataGridTextColumn Header="Idle" Binding="{Binding Idle}" />
                                <DataGridTextColumn Header="Ports" Binding="{Binding Ports}" />
                                <DataGridTextColumn Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Findings -->
            <TabItem Header="{Binding FindingsHeader}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatValue}"
                                                       Text="{Binding Memory}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                               Text="No findings right now."
                               Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </TabItem>

            <!-- Cleanup: WSL memory and disk -->
            <TabItem Header="Cleanup" x:Name="CleanupTab">
                <DockPanel Margin="4">
                    <Border DockPanel.Dock="Top" Style="{StaticResource StatCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="WSL and Docker" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="{Binding WslSummary}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Shut down WSL…" Padding="10,3" Margin="0,0,8,0" Click="WslShutdown_Click" IsEnabled="{Binding IsIdle}" />
                                <Button Content="Turn on automatic reclaim…" Padding="10,3" Margin="0,0,8,0" Click="WslReclaim_Click" IsEnabled="{Binding IsIdle}" />
                                <Button Content="Refresh" Padding="10,3" Click="WslRefresh_Click" IsEnabled="{Binding IsIdle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="Scan disk" Padding="10,3" Margin="0,0,10,0" Click="Scan_Click" IsEnabled="{Binding IsIdle}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource StatLabel}" Text="{Binding ScanStatus}" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Targets}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Clean…" Padding="10,2" Margin="2" Click="Clean_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="What" Binding="{Binding Title}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                            <DataGridTextColumn Header="How" Binding="{Binding Method}" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Activity -->
            <TabItem Header="Activity">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="4,4,4,8" Style="{StaticResource StatLabel}" TextWrapping="Wrap">
                        Everything AgentReclaim stops is written, with its command line and folder, to actions.jsonl in the data folder (tray menu → Open data folder). Relaunch starts it again in a new window.
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Activity}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <Button DockPanel.Dock="Right" Content="Relaunch" Padding="8,1" Click="Relaunch_Click"
                                            Visibility="{Binding CanRelaunch, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock DockPanel.Dock="Left" Width="140" Style="{StaticResource StatLabel}" Text="{Binding Time}" />
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings" x:Name="SettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="Width" Value="60" />
                                <Setter Property="Margin" Value="6,0" />
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,10,0,2" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Automatic actions (all off by default)" />

                        <CheckBox Content="Stop leftovers automatically" IsChecked="{Binding AutoStopLeftovers}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Only leftovers that were seen running under Claude Code or Codex, have no open network connections, pass the safety checks, and have been idle long enough. Guessed owners always wait for you." />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="Idle for at least" VerticalAlignment="Center" />
                            <TextBox Text="{Binding AutoStopIdleMinutes, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="minutes (or" VerticalAlignment="Center" />
                            <TextBox Text="{Binding HookGraceSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="seconds after the Claude Code hook reports the session ended)" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Throttle runaway builds and tests" IsChecked="{Binding AutoThrottleBuilds}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Lowers priority and turns on EcoQoS for build/test tools under an agent, so your desktop stays responsive. They still finish." />
                        <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                            <TextBlock Text="When using over" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ThrottleCpuPercent, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="% CPU for" VerticalAlignment="Center" />
                            <TextBox Text="{Binding ThrottleAfterSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Warn when an agent's memory keeps growing" IsChecked="{Binding LeakWarnings}" />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Disk cleanup" Margin="0,20,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Only offer folders untouched for" VerticalAlignment="Center" />
                            <TextBox Text="{Binding CleanupMinAgeDays, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="days" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Folders with your git repos (one per line; checked two levels deep for stale worktrees):" Margin="0,8,0,2" />
                        <TextBox Text="{Binding ProjectRoots, UpdateSourceTrigger=LostFocus}" Width="Auto" Margin="0" AcceptsReturn="True" MinHeight="50" />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Integrations" Margin="0,20,0,0" />
                        <TextBlock FontWeight="SemiBold" Text="Claude Code SessionEnd hook" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap"
                                   Text="Adds one hook to ~/.claude/settings.json (with a backup) that tells AgentReclaim when a session ends." />
                        <TextBlock Text="{Binding HookStatus}" Margin="0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Install hook…" Padding="10,3" Margin="0,0,8,0" Click="InstallHook_Click" />
                            <Button Content="Remove hook" Padding="10,3" Click="RemoveHook_Click" />
                        </StackPanel>

                        <TextBlock FontWeight="SemiBold" Text="MCP server (read-only)" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap"
                                   Text="Lets an agent ask what is using memory and CPU. It can't stop anything. Add it to Claude Code with:" />
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Copy" Padding="10,3" Margin="8,0,0,0" Click="CopyMcp_Click" />
                            <TextBox Text="{Binding McpCommand, Mode=OneWay}" IsReadOnly="True" Width="Auto" Margin="0" FontFamily="Consolas" />
                        </DockPanel>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Startup" Margin="0,20,0,0" />
                        <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" />

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Updates" Margin="0,20,0,0" />
                        <TextBlock Text="{Binding VersionText}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="When a new version is released:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding UpdateModeIndex}" Width="300">
                                <ComboBoxItem Content="Don't check" />
                                <ComboBoxItem Content="Tell me, I'll install it (recommended)" />
                                <ComboBoxItem Content="Install it automatically" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Checks github.com/baslawson/AgentReclaim once a day. Downloads are verified against the SHA-256 published with the release before installing. Automatic installs wait until this window is closed, then restart the app in the tray." />
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check now" Padding="10,3" Margin="0,0,8,0" Click="CheckUpdates_Click" />
                            <Button Content="Install update" Padding="10,3" Margin="0,0,8,0" Click="InstallUpdate_Click" IsEnabled="{Binding UpdateAvailable}" />
                            <Button Content="Release notes" Padding="10,3" Click="ReleaseNotes_Click" />
                        </StackPanel>

                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Diagnostics" Margin="0,20,0,0" />
                        <CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging}" />
                        <TextBlock Style="{StaticResource StatLabel}" TextWrapping="Wrap" Margin="20,0,0,0"
                                   Text="Logs every poll and decision, not just actions and errors. Logs stay on this PC (7 days, 10 MB a day). Debug logs include command lines, which can contain secrets passed as arguments: check before sharing one." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open logs folder" Padding="10,3" Margin="0,0,8,0" Click="OpenLogs_Click" />
                            <Button Content="Copy diagnostics" Padding="10,3" Click="CopyDiagnostics_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
